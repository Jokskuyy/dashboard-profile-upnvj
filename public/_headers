# Headers for Unity WebGL v0.9.2 build (.unityweb = brotli)
/unity-builds/v0.9.2/Build/*.unityweb
  Content-Encoding: br
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/unity-builds/v0.9.2/Build/*.data.unityweb
  Content-Encoding: br
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/unity-builds/v0.9.2/Build/*.wasm.unityweb
  Content-Encoding: br
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/unity-builds/v0.9.2/Build/*.framework.js.unityweb
  Content-Encoding: br
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable

/unity-builds/v0.9.2/Build/*.loader.js
  Cache-Control: public, max-age=31536000, immutable

# Static assets — immutable caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on
